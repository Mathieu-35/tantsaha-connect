# Copiez ce fichier en ".env" puis adaptez les valeurs.
# Le fichier ".env" ne doit JAMAIS être partagé (il est ignoré par git).

# Port sur lequel le serveur écoute
PORT=3000

# Base de données. En développement : un simple fichier SQLite, rien à installer.
# Plus tard, pour PostgreSQL : postgresql://utilisateur:motdepasse@localhost:5432/tantsaha
DATABASE_URL="file:./dev.db"

# Durée (en minutes) pendant laquelle on garde une météo en mémoire avant de la redemander
WEATHER_CACHE_MINUTES=180
