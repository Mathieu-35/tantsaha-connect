# Copiez ce fichier en ".env" puis adaptez les valeurs.
# Le fichier ".env" ne doit JAMAIS être partagé (il est ignoré par git).

# Port sur lequel le serveur écoute
PORT=3000

# Base de données. En développement : un simple fichier SQLite, rien à installer.
# Plus tard, pour PostgreSQL : postgresql://utilisateur:motdepasse@localhost:5432/tantsaha
DATABASE_URL="file:./dev.db"

# Durée (en minutes) pendant laquelle on garde une météo en mémoire avant de la redemander
WEATHER_CACHE_MINUTES=180

# Clé secrète qui signe les connexions du site d'administration (32 caractères MINIMUM).
# Générez-en une avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne la partagez jamais. En production, utilisez une clé DIFFÉRENTE de celle du développement.
JWT_SECRET=remplacez-moi-par-une-longue-valeur-aleatoire

# Durée d'une connexion admin avant de devoir se reconnecter (ex. 8h, 30m)
JWT_EXPIRES_IN=8h
